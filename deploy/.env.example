# Copy to `.env` (next to docker-compose.nas.yml) and fill in.

# Image refs.
#  Path A (registry):  docker.io/<your-docker-id>/cmms-api:test   (or ghcr.io/<user>/cmms-api:test)
#  Path B (docker load): just the local tag you loaded, e.g. cmms-api:test
API_IMAGE=docker.io/CHANGE_ME/cmms-api:test
WEB_IMAGE=docker.io/CHANGE_ME/cmms-web:test

# Postgres password — set a long random value BEFORE the first run (it's baked
# into the DB on init; changing it later needs the DB volume recreated).
DB_PASSWORD=CHANGE_ME_long_random_password

# NAS shared folder for documents. Create it in DSM first and give the container
# user WRITE access. Mounted read-WRITE: the app writes ONLY in its own zones —
# uploads go to <DOCS_PATH>/inbox, classified files move to <DOCS_PATH>/library/
# <Category>/. Files you organize in other subfolders are indexed in place and
# never touched.
DOCS_PATH=/volume1/documents

# Managed foldering (Phase 2). true = move classified files into library/<Category>/.
# Set false to keep the read-only "index in place" behavior (no moves, no writes).
MANAGED_FOLDERING=true

# The api container must run as a user that can WRITE DOCS_PATH (the chiseled
# .NET image otherwise runs as non-root UID 1654, which can't). Set these to a
# DSM user's UID and group GID that own/can-write the documents share.
# Find your UID over SSH with: id <username>  (DSM home users are usually 1026+,
# the "users" group is GID 100). Defaults below suit a typical single-user NAS.
PUID=1026
PGID=100

# Host port to browse the app on (http://<NAS-IP>:<WEB_PORT>).
WEB_PORT=3000
